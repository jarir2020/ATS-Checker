# Copy this file to .env if you do not already have a local .env file.
APP_NAME=ATS Checker
APP_URL=http://127.0.0.1:8000

# Database used by the current ATS Checker installation.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cv_maker
DB_USER=root
DB_PASS=

# Optional AI assistance. Use one configured provider at a time.
# Supported values: gemini, agnes
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Try these if the primary model is overloaded, rate-limited, or unavailable.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
AGNES_API_KEY=
# Enter a model ID available in your Agnes AI account.
AGNES_MODEL=

# Set this if pdftotext is installed outside the standard paths.
PDFTOTEXT_BIN=/usr/bin/pdftotext
# Set this if pdfimages is installed outside the standard paths. It is used only for optional PDF profile-photo extraction.
PDFIMAGES_BIN=/usr/bin/pdfimages
