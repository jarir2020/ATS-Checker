# Copy this file to .env if you do not already have a local .env file.
APP_NAME=ATS Checker
APP_URL=http://127.0.0.1:8000

# One shared sign-in password protects the whole app. Set a password hash here.
# Generate one with: php -r 'echo password_hash(trim(fgets(STDIN)), PASSWORD_DEFAULT), PHP_EOL;'
APP_PASSWORD_HASH=

# Database used by the current ATS Checker installation.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cv_maker
DB_USER=root
DB_PASS=

# Optional AI assistance. Use one configured provider at a time.
# Supported values: gemini, agnes
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Try these if the primary model is overloaded, rate-limited, or unavailable.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
AGNES_API_KEY=
# Enter a model ID available in your Agnes AI account.
AGNES_MODEL=

# Optional: preferred Poppler binary path. Leave blank to use the Composer PHP fallback.
PDFTOTEXT_BIN=
# Set this if pdfimages is installed outside the standard paths. It is used only for optional PDF profile-photo extraction.
PDFIMAGES_BIN=/usr/bin/pdfimages

# Optional FTP deployment settings used by ./deploy.sh. Keep real values in .env only.
FTP_HOST=
FTP_PORT=21
FTP_USERNAME=
FTP_PASSWORD=
# Keep hostname validation enabled; use no only if your host confirms a certificate-name mismatch is expected.
FTP_TLS_CHECK_HOSTNAME=yes
# deploy.sh intentionally targets ../../ relative to the FTP login directory and ignores FTP_DIRECTORY.

# Set the same random token in the local .env and the server-side .env.
# deploy.sh uses it over HTTPS to request pending SQL migrations after upload.
# Generate one with: openssl rand -hex 32
DEPLOY_MIGRATION_TOKEN=
# Public HTTPS app base URL used for live checks and migrations, e.g. https://example.com/ats-checker/
# DEPLOY_SITE_URL is preferred for smoke checks; either URL fills in the other when blank.
DEPLOY_SITE_URL=
DEPLOY_MIGRATION_URL=
